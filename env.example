# SAKFLY — environment variables (Sprint 1)
#
# Per 07-frontend-security.md §11 / lib/env.ts: API_BASE_URL is
# server-only and intentionally unset in this sprint — no backend exists
# yet. Every service call fails honestly (lib/errors.ts) rather than
# faking success until this is configured against a real api.sakfly.com.

# Server-only. Never exposed to the browser. Leave unset for Sprint 1.
API_BASE_URL=

# Public. Used only for canonical URL / metadata generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
